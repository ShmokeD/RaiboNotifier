<mjml>
    <mj-body background-color="#f4f4f4">
        <mj-section>
            <mj-column>
                <mj-image width="100px" src="https://yourmarketplace.com/logo.png" alt="Marketplace Logo" />
                <mj-divider border-color="#cccccc" />
                <mj-text font-size="20px" font-weight="bold" color="#333333">
                    Product Added Successfully!
                </mj-text>
                <mj-text font-size="16px" color="#555555">
                    Hello {{merchant_name}},
                </mj-text>
                <mj-text font-size="16px" color="#555555">
                    Your product <strong>{{product_name}}</strong> has been successfully added to the marketplace.
                </mj-text>
                <mj-text font-size="14px" color="#777777">
                    <ul>
                        <li><strong>Category:</strong> {{product_category}}</li>
                        <li><strong>Price:</strong> {{product_price}}</li>
                        <li><strong>Status:</strong> {{product_status}}</li>
                    </ul>
                </mj-text>
                <mj-button href="{{product_link}}" background-color="#007bff" color="#ffffff">
                    View Product
                </mj-button>
                <mj-divider border-color="#cccccc" />
                <mj-text font-size="12px" color="#aaaaaa">
                    Thank you for being a valued merchant on our platform.<br/>
                    If you have any questions, contact us at support@yourmarketplace.com.
                </mj-text>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
