<mjml>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text font-size="20px" font-family="Helvetica Neue">
          Hello {{name}},
        </mj-text>
        <mj-text> Verify By clicking the link below: </mj-text>
        <mj-button href="{{ctaLink}}" background-color="#007BFF" color="white">
          {{ctaText}}
        </mj-button>
        <mj-divider border-color="#cccccc" />
        <mj-text font-size="12px" color="#888888">
          © 2025 Your Company
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
