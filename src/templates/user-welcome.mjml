<mjml>
    <mj-body>
        <mj-section>
            <mj-column>
                <mj-text font-size="20px" font-weight="bold">
                    Welcome to Our Service!
                </mj-text>
                <mj-text>
                    Hi {{name}},<br/>
                    Thank you for signing up. Please verify your email address to get started.
                </mj-text>
                <mj-button href="{{verify_link}}" background-color="#346DB7" color="#ffffff">
                    Verify Email
                </mj-button>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
